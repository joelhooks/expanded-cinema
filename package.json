{
  "name": "expanded-cinema",
  "version": "0.1.0",
  "private": true,
  "description": "Expanded cinema \u2014 a daily Three.js sketch agent preserving and branching a body of related studies.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @expanded-cinema/sketch dev",
    "build": "turbo run build",
    "check": "turbo run typecheck && ultracite check && oxfmt --check .",
    "fix": "ultracite fix && oxfmt .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "vendor:agent-sources": "./scripts/vendor-agent-sources.sh",
    "catalog:videos": "node scripts/catalog-videos.mjs"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "lefthook": "2.1.10",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "0.24.0",
    "turbo": "2.10.5",
    "typescript": "7.0.2",
    "ultracite": "7.9.4",
    "vitest": "5.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.3.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.18.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.1.2"
  },
  "packageManager": "pnpm@11.3.0"
}
